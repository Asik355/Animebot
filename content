def parse_reward(reward_type, reward_value):
    reward_type = reward_type.lower().strip()
    if reward_type == "coins":
        if not reward_value.isdigit() or int(reward_value) <= 0:
            return None
        return reward_type, str(int(reward_value))
    if reward_type == "character":
        if not (reward_value.isdigit() and len(reward_value) == 4 and get_character_by_code(reward_value)):
            return None
        return reward_type, reward_value
    return None


