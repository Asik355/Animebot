def format_duration(seconds):
    """Format every cooldown/remaining timer as hours + minutes + seconds."""
    seconds = max(0, int(seconds))
    hours, rem = divmod(seconds, 3600)
    minutes, seconds = divmod(rem, 60)
    return (
        f"{hours} hour" + ("s" if hours != 1 else "") + ", "
        f"{minutes} minute" + ("s" if minutes != 1 else "") + " and "
        f"{seconds} second" + ("s" if seconds != 1 else "")
    )


def spawn_name_matches(spawn_name, entered_parts):
    """Return True only when every entered word is part of the spawned name.

    Matching is case-insensitive, ignores extra whitespace, accepts any subset
    of the name words and allows those words in any order. Duplicate entered
    words must also exist with the same multiplicity in the real name.
    """
    if not entered_parts:
        return False
    import collections
    name_words = collections.Counter(spawn_name.casefold().split())
    entered_words = collections.Counter(
        word.strip().casefold() for word in entered_parts if word.strip()
    )
    if not entered_words:
        return False
    return all(name_words[word] >= count for word, count in entered_words.items())


