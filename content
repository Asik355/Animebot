# Scouts are character-management staff. They can use only the character
# management commands, while Owner/Executive keep their existing powers.
SCOUT_IDS = []

# Runtime guard: the role lists are populated from the database during startup.
# Keep them separate so one user cannot accidentally become both Executive and Scout.
def is_scout(user_id):
    # Use both runtime cache and SQLite so Scout permissions keep working
    # even if the process was restarted or the in-memory list was not refreshed.
    if user_id in SCOUT_IDS:
        return True
    try:
        c = connect(); x = c.cursor()
        x.execute("SELECT 1 FROM staff_roles_v2 WHERE user_id=? AND role='scout' LIMIT 1", (user_id,))
        found = x.fetchone() is not None
        c.close()
        if found and user_id not in SCOUT_IDS and user_id not in EXECUTIVE_IDS and not is_owner(user_id):
            SCOUT_IDS.append(user_id)
        return found
    except Exception as e:
        print("Scout role lookup error:", e)
