async def post_init(app):
    setup_database()

    app.bot_data["active_spawns"] = {}
    app.bot_data["last_calls"] = {}
    app.bot_data["chat_spawn_cooldowns"] = {}
    app.bot_data["unapproved_notified"] = set()
    # Only explicitly owner-approved groups may remain active.
    approved = load_approved_groups()
    app.bot_data["active_chats"] = load_auto_spawn_groups() & approved
    for chat_id in list(load_auto_spawn_groups() - approved):
        unregister_auto_spawn_group(chat_id)
    app.bot_data["spawn_lock"] = asyncio.Lock()

    try:
        await app.bot.delete_my_commands()
        # Global menu = normal user commands only.
        await app.bot.set_my_commands(make_bot_commands(sorted(PUBLIC_COMMANDS)))

        # Per-user menus: staff commands are hidden from everyone else.
        for user_id in set(ADMIN_IDS):
            await refresh_command_menu(app.bot, user_id)
        for user_id in set(EXECUTIVE_IDS):
            if user_id not in ADMIN_IDS:
                await refresh_command_menu(app.bot, user_id)
        for user_id in set(SCOUT_IDS):
            if user_id not in ADMIN_IDS and user_id not in EXECUTIVE_IDS:
                await refresh_command_menu(app.bot, user_id)
    except Exception as e:
        print("Command menu error:", e)

    task = asyncio.create_task(auto_spawn_loop(app))
    app.bot_data["auto_spawn_task"] = task
    auction_task = asyncio.create_task(auction_expiry_loop(app))
    app.bot_data["auction_task"] = auction_task


async def post_shutdown(app):
    auction_task = app.bot_data.get("auction_task")
    if auction_task:
        auction_task.cancel()
        try:
            await auction_task
        except asyncio.CancelledError:
            pass

    task = app.bot_data.get("auto_spawn_task")
    if task:
        task.cancel()
        try:
            await task
        except asyncio.CancelledError:
            pass


