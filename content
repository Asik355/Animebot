    x.execute("""
        INSERT INTO favorites_v2(user_id, character_code, set_at)
        VALUES (?, ?, ?)
        ON CONFLICT(user_id) DO UPDATE SET
            character_code=excluded.character_code,
            set_at=excluded.set_at
    """, (user_id, character_code, timestamp()))
    c.commit()
    c.close()


def clear_favorite(user_id):
    c = connect()
