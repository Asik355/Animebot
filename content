    if not context.args:
        await update.message.reply_text(
            "Usage: /view <4-digit code or character name>\n"
            "Example: /view 1001"
        )
        return

    query = " ".join(context.args).strip()
    character = None

    # First resolve by code. Leading zeroes are accepted (1 == 0001).
    if query.isdigit():
        character = get_character_by_code(query)
    else:
        # Exact name first, then a unique partial name/anime match. This is
        # independent of the user's collection.
        c = connect(); x = c.cursor()
        x.execute("""
            SELECT code,name,anime,rarity,worth,photo_file_id
            FROM characters_v2
            WHERE name=? COLLATE NOCASE OR anime=? COLLATE NOCASE
            ORDER BY CAST(code AS INTEGER)
        """, (query, query))
        exact_rows = x.fetchall()
        if len(exact_rows) == 1:
            character = exact_rows[0]
        elif len(exact_rows) > 1:
            c.close()
            await update.message.reply_text(
                "❓ Multiple characters found. Please use the 4-digit code."
            )
            return
        else:
            like = f"%{query}%"
            x.execute("""
                SELECT code,name,anime,rarity,worth,photo_file_id
                FROM characters_v2
                WHERE name LIKE ? COLLATE NOCASE OR anime LIKE ? COLLATE NOCASE
                ORDER BY CAST(code AS INTEGER)
            """, (like, like))
            rows = x.fetchall()
            if len(rows) == 1:
                character = rows[0]
            elif len(rows) > 1:
                c.close()
                await update.message.reply_text(
                    "❓ Multiple characters found. Please use the 4-digit code."
                )
                return
        c.close()

    if not character:
        await update.message.reply_text("❌ Character not found.")
        return

    code, name, anime, rarity, worth, photo = character
    text = (
        f"🎭 {name}\n"
        f"📺 Anime: {anime or '—'}\n"
        f"🏷 Rarity: {rarity_text(rarity) if rarity else '— Not set'}\n"
        f"💰 Worth: {worth}\n"
        f"🔢 Code: {code}"
    )

    if photo:
        await update.message.reply_photo(photo=photo, caption=text)
    else:
        await update.message.reply_text(text + "\n📷 Photo: Not added")


