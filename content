async def refresh_command_menu(bot, user_id):
    from telegram import BotCommandScopeChat
    # Refresh persisted Scout role into the runtime cache before building the menu.
    is_scout(user_id)
    if is_owner(user_id):
        names = PUBLIC_COMMANDS | EXECUTIVE_COMMANDS | OWNER_COMMANDS
    elif is_executive(user_id):
