    c = connect(); x = c.cursor()
    x.execute("SELECT user_id FROM staff_roles_v2 WHERE role='scout' ORDER BY user_id")
    db_ids = [int(row[0]) for row in x.fetchall()]
    SCOUT_IDS[:] = [uid for uid in db_ids if uid not in EXECUTIVE_IDS and not is_owner(uid)]

    if not SCOUT_IDS:
        c.close()
        await update.message.reply_text("🔭 No Scouts added yet.")
        return

    lines = [f"🔭 Scout Staff ({len(SCOUT_IDS)})", ""]
    for uid in SCOUT_IDS:
        x.execute("SELECT first_name,last_name,username FROM users_v2 WHERE user_id=?", (uid,))
        row = x.fetchone()
        if row:
            first, last, username = row
            name = " ".join(v for v in [first, last] if v).strip() or "Unknown"
            handle = f"@{username}" if username else "No username"
        else:
            name, handle = "Unknown", "No username"
        lines.append(f"• {name} ({handle}) — ID: {uid}")
    c.close()
    await update.message.reply_text("\n".join(lines))


