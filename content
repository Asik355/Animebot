async def sell(update, context):
    save_user(update.effective_user)

    if not context.args:
        await update.message.reply_text(
            "Usage: /sell <4-digit code or exact name> [quantity]\nExample: /sell 1001 2"
        )
        return

    quantity = 1
    lookup_args = context.args
    if len(context.args) >= 2 and context.args[-1].isdigit():
        quantity = int(context.args[-1])
        lookup_args = context.args[:-1]
    if quantity <= 0:
        await update.message.reply_text("❌ Quantity must be at least 1.")
        return
    lookup = " ".join(lookup_args).strip()
    c = connect()
    x = c.cursor()
    try:
        c.execute("BEGIN IMMEDIATE")
        x.execute("""
            SELECT code,name,anime,rarity,worth,photo_file_id
            FROM characters_v2
            WHERE code=? OR name=? COLLATE NOCASE
            LIMIT 1
        """, (lookup, lookup))
        character = x.fetchone()
        if not character:
            c.rollback(); c.close()
            await update.message.reply_text("❌ Character not found.")
            return

        code, name, anime, rarity, worth, photo = character
        x.execute("SELECT id FROM auctions_v2 WHERE seller_id=? AND character_code=? AND active=1 LIMIT 1", (update.effective_user.id, code))
        if x.fetchone():
            c.rollback(); c.close()
            await update.message.reply_text("❌ This character is currently listed in your active auction. Wait until the auction ends before selling it.")
            return
        x.execute("""
            SELECT id FROM collections_v2
            WHERE user_id=? AND character_code=?
            LIMIT ?
        """, (update.effective_user.id, code, quantity))
        owned = x.fetchall()

        if len(owned) < quantity:
            c.rollback(); c.close()
            await update.message.reply_text(
                f"❌ You only have {len(owned)} copy/copies of {name}."
            )
            return

        x.executemany("DELETE FROM collections_v2 WHERE id=?", [(row[0],) for row in owned])
        total_value = worth * quantity
        x.execute(
            "UPDATE users_v2 SET coins=coins+? WHERE user_id=?",
