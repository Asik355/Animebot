# ---------- AUTO-SPAWN GROUP REGISTRY ----------
# Stored separately from the existing SQLite database. This lets automatic
# spawning resume after a bot restart without changing the database.
AUTO_SPAWN_GROUPS_FILE = Path(__file__).with_name("auto_spawn_groups.json")


def load_auto_spawn_groups():
    try:
        if not AUTO_SPAWN_GROUPS_FILE.exists():
            return set()
        data = json.loads(AUTO_SPAWN_GROUPS_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, list):
            return set()
        return {int(chat_id) for chat_id in data}
    except Exception as e:
        print("Auto-spawn group registry load error:", e)
        return set()


def save_auto_spawn_groups(groups):
    try:
        AUTO_SPAWN_GROUPS_FILE.write_text(
            json.dumps(sorted(int(chat_id) for chat_id in groups)),
            encoding="utf-8",
        )
    except Exception as e:
        print("Auto-spawn group registry save error:", e)


def register_auto_spawn_group(chat_id):
    if not chat_id:
        return
    groups = load_auto_spawn_groups()
    if chat_id not in groups:
        groups.add(chat_id)
        save_auto_spawn_groups(groups)


def unregister_auto_spawn_group(chat_id):
    groups = load_auto_spawn_groups()
    if chat_id in groups:
        groups.remove(chat_id)
        save_auto_spawn_groups(groups)


async def is_group_approved(chat_id):
    """Return whether a group has explicit owner approval."""
    approved_file = Path(__file__).with_name("approved_groups.json")
    try:
        if not approved_file.exists():
            return False
        data = json.loads(approved_file.read_text(encoding="utf-8"))
        return int(chat_id) in {int(x) for x in data if str(x).lstrip("-").isdigit()}
    except Exception as e:
        print("Approved group registry read error:", e)
        return False


def save_approved_groups(groups):
    approved_file = Path(__file__).with_name("approved_groups.json")
    try:
        approved_file.write_text(json.dumps(sorted(int(x) for x in groups)), encoding="utf-8")
    except Exception as e:
        print("Approved group registry save error:", e)


def load_approved_groups():
    approved_file = Path(__file__).with_name("approved_groups.json")
    try:
        if not approved_file.exists():
            return set()
        data = json.loads(approved_file.read_text(encoding="utf-8"))
        return {int(x) for x in data if str(x).lstrip("-").isdigit()}
    except Exception:
        return set()


async def require_auction_private(update):
    """Auction actions/settings must be done in the bot's private chat."""
    chat = getattr(update, "effective_chat", None)
    if not chat or chat.type != "private":
        if getattr(update, "message", None):
            await update.message.reply_text(
                "🚫 Auction actions are available only in the bot's PM.\n"
                "Open the bot in private chat to bid, create, or end an auction."
            )
        return False
    return True


async def approve_group(update, context):
    if not is_owner(update.effective_user.id):
        await update.message.reply_text("⚠️ You need to be the owner to use this command.")
        return
    if update.effective_chat.type != "private" or len(context.args) != 1 or not context.args[0].lstrip("-").isdigit():
        await update.message.reply_text("Usage in owner DM: /approvegroup <group_chat_id>")
        return
    chat_id = int(context.args[0])
    groups = load_approved_groups()
    groups.add(chat_id)
    save_approved_groups(groups)
    register_auto_spawn_group(chat_id)
    context.application.bot_data.setdefault("active_chats", set()).add(chat_id)
    context.application.bot_data.setdefault("unapproved_notified", set()).discard(chat_id)
    await update.message.reply_text(f"✅ Group {chat_id} approved. Bot is now active in that group.")


async def revoke_group(update, context):
    if not is_owner(update.effective_user.id):
        await update.message.reply_text("⚠️ You need to be the owner to use this command.")
        return
    if update.effective_chat.type != "private" or len(context.args) != 1 or not context.args[0].lstrip("-").isdigit():
        await update.message.reply_text("Usage in owner DM: /revokegroup <group_chat_id>")
        return
    chat_id = int(context.args[0])
    groups = load_approved_groups()
    groups.discard(chat_id)
    save_approved_groups(groups)
    unregister_auto_spawn_group(chat_id)
    await update.message.reply_text(f"✅ Approval removed for {chat_id}. Auction also turned OFF.")


async def track_group_chat(update, context):
    """Remember only owner-approved groups for automatic spawning."""
    chat = getattr(update, "effective_chat", None)
    if chat and chat.type in ("group", "supergroup") and await is_group_approved(chat.id):
        register_auto_spawn_group(chat.id)
        context.application.bot_data.setdefault("active_chats", set()).add(chat.id)


async def track_bot_membership(update, context):
    """Require explicit owner approval before the bot stays in a group."""
    chat = getattr(update, "effective_chat", None)
    member_update = getattr(update, "my_chat_member", None)
    if not chat or chat.type not in ("group", "supergroup") or not member_update:
        return

    status = member_update.new_chat_member.status
    if status in ("member", "administrator"):
        if await is_group_approved(chat.id):
            register_auto_spawn_group(chat.id)
            context.application.bot_data.setdefault("active_chats", set()).add(chat.id)
            return

        # Stay in the group, but remain completely inactive until the owner approves it.
        # Only send the approval notice once per group to avoid spam.
        notified = context.application.bot_data.setdefault("unapproved_notified", set())
        if chat.id not in notified:
            notified.add(chat.id)
            try:
                await context.bot.send_message(
                    chat_id=chat.id,
                    text=(
                        "🚫 This group is not approved yet.\n"
                        "👑 Contact the bot owner to approve this group.\n"
                        f"🆔 Group ID: {chat.id}"
                    ),
                )
            except Exception as e:
                print(f"Unapproved group notice error for {chat.id}:", e)
            owner_id = ADMIN_IDS[0] if ADMIN_IDS else None
            if owner_id:
                try:
                    await context.bot.send_message(
                        chat_id=owner_id,
                        text=(
                            "🚫 New group needs approval.\n\n"
                            f"🏷️ Group: {chat.title or 'Unknown'}\n"
                            f"🆔 Chat ID: {chat.id}\n\n"
                            f"Approve with: /approvegroup {chat.id}"
                        ),
                    )
                except Exception as e:
                    print("Owner group-approval notification error:", e)
        unregister_auto_spawn_group(chat.id)
        context.application.bot_data.setdefault("active_chats", set()).discard(chat.id)
    elif status in ("left", "kicked"):
        unregister_auto_spawn_group(chat.id)
        context.application.bot_data.setdefault("active_chats", set()).discard(chat.id)


