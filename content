async def history(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Owner-only spawn history. Usage: /history or /history 20"""
    if not is_owner(update.effective_user.id):
        await update.message.reply_text("⛔ This command is Owner-only.")
        return

    limit = 20
    if context.args:
        try:
            limit = max(1, min(int(context.args[0]), 50))
        except ValueError:
            await update.message.reply_text("Usage: /history [1-50]")
            return

    rows = []
    try:
        conn = connect()
        cur = conn.cursor()
        cur.execute("""
            SELECT h.character_code, h.rarity, h.spawned_by, h.spawned_at,
                   h.caught_by, h.caught_at, c.name
            FROM spawn_history_v2 h
            LEFT JOIN characters_v2 c ON c.code = h.character_code
            ORDER BY h.id DESC
            LIMIT ?
        """, (limit,))
        rows = cur.fetchall()
        conn.close()
    except Exception as e:
        print("history error:", e)
        await update.message.reply_text("❌ Could not load spawn history.")
        return

    if not rows:
        await update.message.reply_text("📜 No spawn history yet.")
        return

    now = datetime.now()
    lines = [f"📜 <b>Spawn History</b> — latest {len(rows)}", ""]
    for i, row in enumerate(rows, 1):
        code, rarity, spawned_by, spawned_at, caught_by, caught_at, name = row
        char_name = name or "Unknown Character"
        try:
            spawned_dt = datetime.fromisoformat(spawned_at)
            spawned_text = spawned_dt.strftime("%d %b %Y, %H:%M")
            expired = (now - spawned_dt).total_seconds() >= SPAWN_LIFETIME
        except Exception:
            spawned_text = str(spawned_at)
            expired = False

        source_map = {
            "auto_spawn": "Auto",
            "manual_spawn": "Manual /spawn",
            "owner_callchar": "Owner /callchar",
            "auto": "Auto",
            "manual": "Manual",
        }
        source = source_map.get(spawned_by, spawned_by or "Unknown")

        if caught_by:
            caught_text = f"Caught by <code>{caught_by}</code>"
            if caught_at:
                try:
                    caught_text += f" at {datetime.fromisoformat(caught_at).strftime('%d %b %Y, %H:%M')}"
                except Exception:
                    caught_text += f" at {caught_at}"
        elif expired:
            caught_text = "⏰ Expired / uncaught"
        else:
            caught_text = "🟢 Still active / uncaught"

        lines.append(
            f"<b>#{i} {char_name}</b> [{rarity}]\n"
            f"Code: <code>{code}</code> • Spawned: {spawned_text}\n"
            f"By: {source}\n"
            f"{caught_text}"
        )

    await update.message.reply_text("\n\n".join(lines), parse_mode="HTML")

