async def daily(update, context):
    save_user(update.effective_user)
    user_id = update.effective_user.id
    now_dt = datetime.now()

    # Read reward pools before opening the write transaction.
    rare_characters = get_characters_by_rarity("Rare")
    common_characters = get_characters_by_rarity("Common")
    if not rare_characters or len(common_characters) < 2:
        await update.message.reply_text(
            "❌ Daily reward cannot be prepared because the required Rare/Common characters are missing."
        )
        return

    rare = random.choice(rare_characters)
    common_pool = random.sample(common_characters, 2)
    rewards = [rare, common_pool[0], common_pool[1]]

    c = connect()
    x = c.cursor()
    try:
        c.execute("BEGIN IMMEDIATE")
        x.execute("SELECT last_daily FROM users_v2 WHERE user_id=?", (user_id,))
        row = x.fetchone()

        if row and row[0]:
            try:
                last = datetime.fromisoformat(row[0])
                reset = now_dt.replace(hour=DAILY_RESET_HOUR, minute=0, second=0, microsecond=0)
                if now_dt < reset:
                    reset -= timedelta(days=1)
                if last >= reset:
                    c.rollback()
                    await update.message.reply_text("⏳ Daily already claimed.")
                    return
            except (ValueError, TypeError):
                # Bad legacy timestamp should not permanently block daily.
                pass

        x.execute("UPDATE users_v2 SET coins=coins+?, last_daily=? WHERE user_id=?",
                  (DAILY_COINS, timestamp(), user_id))
        if x.rowcount != 1:
            raise RuntimeError("daily user row missing")

        caught_at = timestamp()
        for character in rewards:
            x.execute("INSERT INTO collections_v2(user_id, character_code, caught_at) VALUES(?,?,?)",
                      (user_id, character[0], caught_at))
        c.commit()
    except Exception as e:
        try:
            c.rollback()
        except Exception:
            pass
        print("Daily transaction error:", e)
        await update.message.reply_text("❌ Daily reward could not be claimed. Please try again.")
        return
    finally:
        c.close()

    await update.message.reply_text(
        "🎁 Daily Reward!\n\n"
        f"💰 +{DAILY_COINS} coins\n"
        "🎭 +1 Rare character\n"
        "⚪ +2 Common characters\n\n"
        f"🔵 {rare[1]} [{rare[0]}]\n"
        f"⚪ {common_pool[0][1]} [{common_pool[0][0]}]\n"
        f"⚪ {common_pool[1][1]} [{common_pool[1][0]}]"
    )

    for character in rewards:
        photo = character[5]
        if photo:
            try:
                await update.message.reply_photo(
                    photo=photo,
                    caption=f"{rarity_text(character[3])} {character[1]}",
                )
            except Exception as e:
                print("Daily photo error:", e)


