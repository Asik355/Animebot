def get_today_key():
    now = datetime.now()
    # The configured daily reset hour determines the active "day".
    if now.hour < DAILY_RESET_HOUR:
        now -= timedelta(days=1)
    return now.strftime("%Y-%m-%d")


def reserve_rarity(rarity):
    """
    Reserve a rarity for a normal/automatic spawn.
    Returns (True, "") when allowed.
    Returns (False, reason) when the rarity is currently blocked.

    This function is intentionally NOT used for daily rewards.
    """
    if rarity in ("Common", "Rare", "Epic"):
        return True, ""

    c = connect()
    x = c.cursor()

    today_key = get_today_key()

    x.execute("""
        SELECT day_key, legendary_count, mythic_count, celestial_next_at
        FROM spawn_limits_v2
        WHERE id=1
    """)
    row = x.fetchone()

    if not row:
        x.execute("""
            INSERT INTO spawn_limits_v2
            (id, day_key, legendary_count, mythic_count, celestial_next_at)
            VALUES (1, ?, 0, 0, NULL)
        """, (today_key,))
        day_key, legendary_count, mythic_count, celestial_next_at = (
            today_key, 0, 0, None
        )
    else:
        day_key, legendary_count, mythic_count, celestial_next_at = row

    # Reset daily counters when the configured daily period changes.
    if day_key != today_key:
        legendary_count = 0
        mythic_count = 0
        x.execute("""
            UPDATE spawn_limits_v2
            SET day_key=?, legendary_count=0, mythic_count=0
            WHERE id=1
        """, (today_key,))

    now_dt = datetime.now()

    if rarity == "Legendary":
        if legendary_count >= LEGENDARY_DAILY_LIMIT:
            c.commit()
            c.close()
            return False, "💎 Today's Legendary spawn limit (8) has been reached."
        legendary_count += 1
        x.execute("""
            UPDATE spawn_limits_v2
            SET day_key=?, legendary_count=?
            WHERE id=1
        """, (today_key, legendary_count))

    elif rarity == "Mythic":
        if mythic_count >= MYTHIC_DAILY_LIMIT:
            c.commit()
            c.close()
            return False, "💠 Today's Mythic spawn limit (3) has been reached."
        mythic_count += 1
        x.execute("""
            UPDATE spawn_limits_v2
            SET day_key=?, mythic_count=?
            WHERE id=1
        """, (today_key, mythic_count))

    elif rarity == "Celestial":
        next_dt = None
        if celestial_next_at:
            try:
                next_dt = datetime.fromisoformat(celestial_next_at)
            except ValueError:
                next_dt = None

        if next_dt and now_dt < next_dt:
            remaining = next_dt - now_dt
            remaining_text = format_duration(remaining.total_seconds())
            c.commit()
            c.close()
            return False, (
                f"🧠 Celestial is on cooldown.\n"
                f"⏳ Try again in {remaining_text}."
            )

        # A Celestial spawn starts a new random 48-72 hour cooldown.
        cooldown_hours = random.randint(
            CELESTIAL_MIN_HOURS,
            CELESTIAL_MAX_HOURS
        )
        next_dt = now_dt + timedelta(hours=cooldown_hours)

        x.execute("""
            UPDATE spawn_limits_v2
            SET day_key=?, celestial_next_at=?
            WHERE id=1
        """, (today_key, next_dt.isoformat(timespec="seconds")))

    c.commit()
    c.close()
    return True, ""


def rollback_rarity_reservation(rarity):
    """Undo a rarity reservation when Telegram rejects the spawn message."""
    if rarity in ("Common", "Rare", "Epic"):
        return

    c = connect()
    x = c.cursor()
    today_key = get_today_key()
    x.execute(
        "SELECT day_key, legendary_count, mythic_count FROM spawn_limits_v2 WHERE id=1"
    )
    row = x.fetchone()
    if not row:
        c.close()
        return

    day_key, legendary_count, mythic_count = row
    if day_key != today_key:
        c.close()
        return

    if rarity == "Legendary":
        x.execute(
            "UPDATE spawn_limits_v2 SET legendary_count=? WHERE id=1",
            (max(0, legendary_count - 1),),
        )
    elif rarity == "Mythic":
        x.execute(
            "UPDATE spawn_limits_v2 SET mythic_count=? WHERE id=1",
            (max(0, mythic_count - 1),),
        )
    elif rarity == "Celestial":
        # Celestial was eligible only because its cooldown had expired;
        # undo the newly-created cooldown if the message was not sent.
        x.execute(
            "UPDATE spawn_limits_v2 SET celestial_next_at=NULL WHERE id=1"
        )

    c.commit()
    c.close()


def allowed_rarities():
    result = []

    for rarity in ("Common", "Rare", "Epic", "Legendary", "Mythic", "Celestial"):
        c = connect()
        x = c.cursor()

        today_key = get_today_key()
        x.execute("""
            SELECT day_key, legendary_count, mythic_count, celestial_next_at
            FROM spawn_limits_v2
            WHERE id=1
        """)
        row = x.fetchone()
        c.close()

        if not row:
            result.append(rarity)
            continue

        day_key, legendary_count, mythic_count, celestial_next_at = row
        if day_key != today_key:
            legendary_count = 0
            mythic_count = 0

        if rarity in ("Common", "Rare", "Epic"):
            result.append(rarity)
        elif rarity == "Legendary" and legendary_count < LEGENDARY_DAILY_LIMIT:
            result.append(rarity)
        elif rarity == "Mythic" and mythic_count < MYTHIC_DAILY_LIMIT:
            result.append(rarity)
        elif rarity == "Celestial":
            if not celestial_next_at:
                result.append(rarity)
            else:
                try:
                    if datetime.now() >= datetime.fromisoformat(celestial_next_at):
                        result.append(rarity)
                except ValueError:
                    result.append(rarity)

    return result


def choose_character():
    """
    Choose a random character while respecting global rarity limits.
    High-rarity choices that are currently blocked are removed from the
    weighted pool, so the bot falls back to available rarities.
    """
    allowed = set(allowed_rarities())
    available = [(r, w) for r, w in CHANCES if r in allowed]

    # If a configured high-rarity class has no characters, remove it.
    available = [
        (rarity, weight)
        for rarity, weight in available
        if get_characters_by_rarity(rarity)
    ]

    if not available:
        return None

    rarity = random.choices(
        [r for r, _ in available],
        weights=[w for _, w in available],
        k=1,
    )[0]

    return choose_character_for_rarity(rarity)


async def send_spawn(chat_id, context, character):
    code, name, anime, rarity, worth, photo = character
    app = getattr(context, "application", context)
    bot = getattr(context, "bot", None) or app.bot

    active = app.bot_data.setdefault("active_spawns", {})

    # spawn_reserved() reserves this entry before the network call. Keep a
    # fallback here for any legacy/direct caller.
    active.setdefault(chat_id, {
        "code": code, "name": name, "anime": anime, "rarity": rarity,
        "worth": worth, "photo": photo,
        "expires_at": datetime.now() + timedelta(seconds=SPAWN_LIFETIME),
    })

    try:
        if photo:
            await asyncio.wait_for(
                bot.send_photo(
                    chat_id=chat_id, photo=photo,
                    caption=(f"A {rarity} {SYMBOL.get(rarity, '⭐')} character has appeared...\n\n"
                              "Use /add to catch them!"),
                ),
                timeout=20,
            )
        else:
            await asyncio.wait_for(
                bot.send_message(
                    chat_id=chat_id,
                    text=(f"A {rarity} {SYMBOL.get(rarity, '⭐')} character has appeared...\n\n"
                          "📷 Photo not added yet.\n"
                          "Use /add to catch them!"),
                ),
                timeout=20,
            )
    except Exception:
        active.pop(chat_id, None)
        raise

    app.bot_data.setdefault("chat_spawn_cooldowns", {})[chat_id] = (
        datetime.now() + timedelta(seconds=GROUP_SPAWN_COOLDOWN)
    )


async def spawn_reserved(chat_id, context, character, spawned_by="manual"):
    app = getattr(context, "application", context)
    lock = get_spawn_lock(app)

    # Only protect the in-memory reservation. Never hold this global lock while
    # waiting for Telegram, otherwise one slow group can freeze all spawns.
    async with lock:
        active = app.bot_data.setdefault("active_spawns", {})
        if chat_id in active:
            return False, "❌ A character is already spawned in this chat."
        allowed, reason = reserve_rarity(character[3])
        if not allowed:
            return False, reason
        active[chat_id] = {
            "code": character[0], "name": character[1], "anime": character[2],
            "rarity": character[3], "worth": character[4], "photo": character[5],
            "recruit_names": get_recruit_names(character[0]),
            "expires_at": datetime.now() + timedelta(seconds=SPAWN_LIFETIME),
        }

    try:
        await send_spawn(chat_id, context, character)
    except Exception:
        async with lock:
            app.bot_data.setdefault("active_spawns", {}).pop(chat_id, None)
            rollback_rarity_reservation(character[3])
        raise

    try:
        history_id = record_spawn_history(chat_id, character, spawned_by)
        app.bot_data["active_spawns"].get(chat_id, {})["history_id"] = history_id
    except Exception as e:
        # History must never make an already-sent spawn fail.
        print("Spawn history error:", e)
    return True, ""


