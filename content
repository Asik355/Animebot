            return
        reward_type, reward_value, _ = row
        if reward_type == "coins":
            x.execute("UPDATE users_v2 SET coins=coins+? WHERE user_id=?", (int(reward_value), user_id))
        else:
            x.execute("SELECT name FROM characters_v2 WHERE code=? LIMIT 1", (str(reward_value),))
