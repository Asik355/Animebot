async def delete(update, context):
    if not is_owner(update.effective_user.id):
        await update.message.reply_text("⚠️ You need to be the owner to use this command.")
        return

    if not context.args:
        await update.message.reply_text(
            "Usage: /delete <name or code>"
        )
        return

    character = get_character(" ".join(context.args))

    if not character:
        await update.message.reply_text("❌ Character not found.")
        return

    code, name, anime, rarity, worth, photo = character

    # Do not leave an active in-memory spawn pointing at a character that
    # has just been deleted. Serialize this with /add and spawn operations.
    lock = get_spawn_lock(context.application)
    async with lock:
        active = context.application.bot_data.setdefault("active_spawns", {})
        removed_active = {}
        for chat_id, spawn_data in list(active.items()):
            if str(spawn_data.get("code")) == str(code):
                removed_active[chat_id] = spawn_data
                del active[chat_id]

        c = connect()
        x = c.cursor()
        try:
            x.execute(
                "DELETE FROM collections_v2 WHERE character_code=?",
                (code,),
            )
            x.execute(
                "DELETE FROM favorites_v2 WHERE character_code=?",
                (code,),
            )
            x.execute(
                "DELETE FROM characters_v2 WHERE code=?",
                (code,),
            )
            c.commit()
        except Exception as e:
            c.rollback()
            c.close()
            # Restore any active spawns if the DB deletion failed.
            active.update(removed_active)
            print("delete character error:", e)
            await update.message.reply_text("❌ Could not delete the character.")
            return
        c.close()

        # The active spawn had already consumed its rarity reservation.
        # Since deletion removes that spawn without a catch, release it.
        for spawn_data in removed_active.values():
            rollback_rarity_reservation(spawn_data.get("rarity"))

    await update.message.reply_text(
        f"🗑 Deleted {name} [{code}]."
        + (f"\n🧹 Removed {len(removed_active)} active spawn(s)." if removed_active else "")
    )


