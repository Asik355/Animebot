def parse_auction_duration(text):
    import re
    value = (text or "").strip().lower()
    if not value:
        return None
    # Accept combinations such as 3h, 1d 5h, 2d 12h 30m.
    # Units are days/hours/minutes; each unit may appear at most once.
    matches = re.findall(r"(\d+)\s*([dhm])\b", value)
    remainder = re.sub(r"(\d+)\s*([dhm])\b", "", value).strip()
    if not matches or remainder:
        return None
    units = {}
    for amount, unit in matches:
        if unit in units:
            return None
        units[unit] = int(amount)
    if any(v < 0 for v in units.values()):
        return None
    total_minutes = units.get("d", 0) * 1440 + units.get("h", 0) * 60 + units.get("m", 0)
    if total_minutes < 180:
        return None
    return total_minutes


