# ---------- AUTO SPAWN ----------
async def _auto_spawn_one_chat(app, chat_id):
    """Process one registered group without allowing a stuck Telegram call
    to stop automatic spawning for every other group."""
    active_spawns = app.bot_data.setdefault("active_spawns", {})
    now_dt = datetime.now()

    spawn = active_spawns.get(chat_id)
    if spawn:
        if now_dt >= spawn["expires_at"]:
            # Remove the expired spawn before doing network I/O so this chat
            # cannot remain permanently stuck if Telegram is slow/unavailable.
            active_spawns.pop(chat_id, None)
            # The spawn reserved a global rarity quota. Expiry is not a successful
            # catch, so release that reservation before the next spawn.
            try:
                rollback_rarity_reservation(spawn.get("rarity"))
            except Exception as e:
                print(f"Rarity rollback error for expired spawn {chat_id}:", e)
            try:
                await asyncio.wait_for(
                    app.bot.send_message(
                        chat_id=chat_id,
                        text="⏰ The character is gone! No one added them.",
                    ),
                    timeout=15,
                )
            except Exception as e:
                print(f"Expiry notification error for {chat_id}:", e)
        else:
            return

    character = choose_character()
    if not character:
        return

    try:
        # A broken/slow group must not block the whole auto-spawn loop.
        success, reason = await asyncio.wait_for(
            spawn_reserved(chat_id, app, character, "auto_spawn"),
            timeout=45,
        )
        if not success and reason:
            return
    except asyncio.TimeoutError:
        print(f"Auto spawn timeout for {chat_id}; continuing with other groups.")
    except Exception as e:
        print(f"Auto spawn error for {chat_id}:", e)


async def auto_spawn_loop(app):
    # A character lasts 10 minutes. Auto-spawn checks every 15 minutes.
    # This loop is intentionally self-recovering: one bad group or Telegram
    # request can never terminate the background task for all groups.
    while True:
        try:
            active_chats = app.bot_data.setdefault("active_chats", set())

            # Process groups concurrently. A slow Telegram request in one group
            # must never make every other group's auto-spawn wait behind it.
            async def safe_one(chat_id):
                try:
                    await _auto_spawn_one_chat(app, chat_id)
                except asyncio.CancelledError:
                    raise
                except Exception as e:
                    print(f"Auto spawn group loop error for {chat_id}:", e)

            await asyncio.gather(
                *(safe_one(chat_id) for chat_id in list(active_chats)),
                return_exceptions=True,
            )

        except asyncio.CancelledError:
            # Normal application shutdown. Never restart a deliberately
            # cancelled task.
            raise
        except Exception as e:
            # Recover from unexpected loop-level errors and continue.
            print("Auto spawn loop error; recovering:", e)

        try:
            await asyncio.sleep(900)
        except asyncio.CancelledError:
            raise
        except Exception as e:
            print("Auto spawn sleep error; recovering:", e)


