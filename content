async def bid(update, context):
    save_user(update.effective_user)
    # Bidding is intentionally allowed in both groups and the bot PM.
    if len(context.args)!=2 or not context.args[0].isdigit() or not context.args[1].isdigit():
        await update.message.reply_text("Usage: /bid <auction_id> <amount>")
        return
    auction_id=int(context.args[0]); amount=int(context.args[1])
    if amount<1:
        await update.message.reply_text("❌ Bid must be at least 1 coin.")
        return
    bidder=update.effective_user.id
    c=connect(); x=c.cursor()
    previous_bidder=None; previous_amount=0; seller_id=None; code=None
    try:
        c.execute("BEGIN IMMEDIATE")
        x.execute("SELECT seller_id,character_code,start_bid,current_bid,highest_bidder_id,ends_at FROM auctions_v2 WHERE id=? AND active=1",(auction_id,))
        row=x.fetchone()
        if not row:
            c.rollback(); c.close(); await update.message.reply_text("❌ Auction not found or already ended."); return
        seller_id,code,start_bid,current_bid,previous_bidder,ends_at=row
        if datetime.fromisoformat(ends_at) <= datetime.now():
            c.rollback(); c.close(); await update.message.reply_text("⏰ This auction has expired. Please wait for settlement."); return
        if bidder==seller_id:
            c.rollback(); c.close(); await update.message.reply_text("❌ You cannot bid on your own auction."); return
        minimum=max(start_bid,current_bid+1 if previous_bidder else start_bid)
        if amount<minimum:
            c.rollback(); c.close(); await update.message.reply_text(f"❌ Minimum bid is {minimum} coins."); return
        x.execute("SELECT coins FROM users_v2 WHERE user_id=?",(bidder,)); b=x.fetchone()
        bidder_coins=b[0] if b else 0
        # A bidder's previous active bid is not stacked; they must have enough
        # coins for the new total amount. The old high bid is refunded first.
        available = bidder_coins + (current_bid if previous_bidder == bidder else 0)
        if available < amount:
            c.rollback(); c.close(); await update.message.reply_text(f"❌ You need {amount} coins for this bid. You have {available} available."); return
        if previous_bidder:
            x.execute("UPDATE users_v2 SET coins=coins+? WHERE user_id=?",(current_bid,previous_bidder))
            previous_amount=current_bid
        x.execute("UPDATE users_v2 SET coins=coins-? WHERE user_id=?",(amount,bidder))
        x.execute("INSERT INTO auction_bids_v2(auction_id,bidder_id,amount,created_at) VALUES(?,?,?,?)",(auction_id,bidder,amount,timestamp()))
        x.execute("UPDATE auctions_v2 SET current_bid=?,highest_bidder_id=? WHERE id=?",(amount,bidder,auction_id))
        c.commit()
    except Exception as e:
        c.rollback(); c.close(); print("Auction bid error:",e); await update.message.reply_text("❌ Bid failed. Please try again."); return
    c.close()
    await update.message.reply_text(f"✅ Bid placed!\n🔨 Auction #{auction_id}\n💰 {amount} coins")
    try:
        if previous_bidder and previous_bidder!=bidder:
            await context.bot.send_message(previous_bidder, f"↩️ You were outbid on Auction #{auction_id}.\nYour {current_bid} coins have been refunded.")
        await context.bot.send_message(seller_id, f"🔔 New bid on your Auction #{auction_id}!\n🎭 [{code}]\n💰 Bid: {amount} coins\n👤 Bidder ID: {bidder}")
    except Exception as e:
        print("Auction bid notification error:",e)


async def settle_auction(context, auction_id, reason="expired"):
    c=connect(); x=c.cursor(); seller_id=winner_id=code=None; amount=0; returned=False
    try:
        c.execute("BEGIN IMMEDIATE")
        x.execute("SELECT seller_id,character_code,current_bid,highest_bidder_id,ends_at FROM auctions_v2 WHERE id=? AND active=1",(auction_id,))
        row=x.fetchone()
        if not row:
            c.rollback(); c.close(); return None
        seller_id,code,amount,winner_id,ends_at=row
        if reason=="expired" and datetime.fromisoformat(ends_at)>datetime.now():
            c.rollback(); c.close(); return None
        if winner_id:
            # Character stayed in seller collection during the auction.
            # Remove exactly one copy now, then give it to the winner.
            x.execute(
                "SELECT id FROM collections_v2 WHERE user_id=? AND character_code=? LIMIT 1",
                (seller_id, code),
            )
            seller_row = x.fetchone()
            if not seller_row:
                c.rollback()
                c.close()
                print(f"Auction settlement blocked: seller {seller_id} no longer owns {code}.")
                return None
            x.execute("DELETE FROM collections_v2 WHERE id=?", (seller_row[0],))
            x.execute(
                "INSERT INTO collections_v2(user_id,character_code,caught_at) VALUES(?,?,?)",
                (winner_id, code, timestamp()),
            )
            x.execute("UPDATE auctions_v2 SET active=0 WHERE id=?",(auction_id,))
            x.execute("UPDATE users_v2 SET coins=coins+? WHERE user_id=?",(amount,seller_id))
        else:
            # No bids: character was never removed, so simply close the auction.
            x.execute("UPDATE auctions_v2 SET active=0 WHERE id=?",(auction_id,))
            returned=True
        c.commit()
    except Exception as e:
        c.rollback(); c.close(); print("Auction settle error:",e); return None
    c.close()
    return {"seller_id":seller_id,"winner_id":winner_id,"code":code,"amount":amount,"returned":returned,"reason":reason}


