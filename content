# ---------- GROUP-ONLY SPAWN ----------
def is_group_chat(update):
    """Return True only for Telegram groups/supergroups."""
    chat = getattr(update, "effective_chat", None)
    return bool(chat and chat.type in ("group", "supergroup"))


async def require_group_spawn(update):
    """Block character spawning/catching in private DMs."""
    if is_group_chat(update):
        return True
    if getattr(update, "message", None):
        await update.message.reply_text(
            "🚫 Character spawning works only in groups.\n"
            "➜ Add me to a group and use /spawn there."
        )
    return False


# ---------- RANDOM / OWNER SPAWN ----------
async def spawn(update, context):
    save_user(update.effective_user)
    if not await require_group_spawn(update):
        return
    chat_id = update.effective_chat.id
    user_id = update.effective_user.id
    now_dt = datetime.now()

    active = context.application.bot_data.setdefault("active_spawns", {})
    if chat_id in active:
        await update.message.reply_text(
            "❌ A character is already spawned in this chat.\nUse /add to catch it."
        )
        return

    # Personal cooldown: 1 hour from this user's last successful /spawn.
    last_calls = context.application.bot_data.setdefault("last_calls", {})
    last = last_calls.get(user_id)
    if last:
        try:
            last_dt = last if isinstance(last, datetime) else datetime.fromisoformat(last)
            remaining = PERSONAL_SPAWN_COOLDOWN - (now_dt - last_dt).total_seconds()
        except (TypeError, ValueError):
            remaining = 0
        if remaining > 0:
            # Show the exact remaining 1-hour cooldown, including seconds.
            remaining_text = format_duration(remaining)
            await update.message.reply_text(
                f"⚠️ Please wait {remaining_text} before spawning again."
            )
            return

    # Chat cooldown: 70 seconds from the exact successful spawn time.
    chat_cooldowns = context.application.bot_data.setdefault("chat_spawn_cooldowns", {})
    cooldown_until = chat_cooldowns.get(chat_id)
    if cooldown_until:
        remaining = (cooldown_until - now_dt).total_seconds()
        if remaining > 0:
            await update.message.reply_text(
                f"⏳ This chat can spawn again in {format_duration(remaining)}."
            )
            return
        chat_cooldowns.pop(chat_id, None)

    character = choose_character()
    if not character:
        await update.message.reply_text("❌ No characters available.")
        return

    try:
        success, reason = await spawn_reserved(chat_id, context, character, "manual_spawn")
    except Exception as e:
        print("Call spawn error:", e)
        await update.message.reply_text("❌ Failed to spawn character.")
        return

    if not success:
        await update.message.reply_text(reason)
        return

    # Start the personal cooldown only after the spawn was actually sent.
    last_calls[user_id] = datetime.now()
    context.application.bot_data.setdefault("active_chats", set()).add(chat_id)


async def callchar(update, context):
    save_user(update.effective_user)
    if not await require_group_spawn(update):
        return
    chat_id = update.effective_chat.id

    async def tell(text):
        await context.bot.send_message(chat_id=chat_id, text=text)

    if not is_owner(update.effective_user.id):
        await tell("⚠️ You need to be the owner to use this command.")
        return

    if not context.args:
        await tell(
            "Usage: /callchar <4-digit code>\n\nExample:\n/callchar 1001"
        )
        return

    active = context.application.bot_data.setdefault("active_spawns", {})
    if chat_id in active:
        await tell("❌ A character is already spawned in this chat.\nUse /add to catch it first.")
        return

    code = " ".join(context.args).strip()
    if not (code.isdigit() and len(code) == 4 and 1 <= int(code) <= 9999):
        await tell("❌ Use the character's unique 4-digit code (0001-9999).")
        return

    character = get_character_by_code(code)
    if not character:
        await tell("❌ Character not found for that code.")
        return

    try:
        success, reason = await spawn_reserved(chat_id, context, character, "owner_callchar")
    except Exception as e:
        print("Callchar spawn error:", e)
        await tell("❌ Failed to spawn character.")
        return

    if not success:
        await tell(reason)
        return

    context.application.bot_data.setdefault("active_chats", set()).add(chat_id)


# ---------- CATCH ----------
async def add(update, context):
    save_user(update.effective_user)
    # Catching is group-only too. Keep DMs silent for /add, matching the
    # existing silent behavior for /add without arguments.
    if not is_group_chat(update):
        return
    chat_id = update.effective_chat.id
    active = context.application.bot_data.setdefault("active_spawns", {})
    spawn = active.get(chat_id)

    # /add without a name must be completely silent.
    if not context.args:
        return

    if not spawn:
        return

    now_dt = datetime.now()
    if now_dt >= spawn["expires_at"]:
        del active[chat_id]
        try:
            rollback_rarity_reservation(spawn.get("rarity"))
        except Exception as e:
            print("Catch expiry rarity rollback error:", e)
        await update.message.reply_text("⏰ The character is gone! No one added them.")
        return

    # Serialize catch/expiry handling so two users cannot both catch the
    # same in-memory spawn between the validation and the delete.
    lock = get_spawn_lock(context.application)
    async with lock:
        active = context.application.bot_data.setdefault("active_spawns", {})
        spawn = active.get(chat_id)
        if not spawn:
            return
        if datetime.now() >= spawn["expires_at"]:
            del active[chat_id]
            try:
                rollback_rarity_reservation(spawn.get("rarity"))
            except Exception as e:
                print("Locked catch expiry rarity rollback error:", e)
            await update.message.reply_text("⏰ The character is gone! No one added them.")
            return

        # Validate against the CURRENT locked spawn. This prevents a stale
        # validation from ever catching a different character.
        entered = [part for part in context.args if part.strip()]
        entered_text = " ".join(entered).strip()
        valid_code = (
            entered_text.isdigit()
            and len(entered_text) == 4
            and entered_text == str(spawn["code"])
        )
        valid_name = spawn_name_matches(spawn["name"], entered)
        if not valid_name:
            for recruit_name in spawn.get("recruit_names", []):
                if spawn_name_matches(recruit_name, entered):
                    valid_name = True
                    break
        if not (valid_code or valid_name):
            return

        c = connect()
        x = c.cursor()
        try:
            x.execute(
                "INSERT INTO collections_v2(user_id, character_code, caught_at) VALUES(?,?,?)",
                (update.effective_user.id, spawn["code"], timestamp()),
            )
            x.execute(
                "UPDATE users_v2 SET coins=coins+50 WHERE user_id=?",
                (update.effective_user.id,),
            )
            c.commit()
        except Exception:
            c.rollback()
            c.close()
            return
        c.close()

        mark_spawn_caught(spawn.get("history_id"), update.effective_user.id)
        del active[chat_id]

    # No 5-6 minute post-catch wait. The auto-spawn loop will spawn again
    # on its next cycle. The chat's 70-second manual cooldown remains based
    # on the original spawn time.
    caught_rarity = spawn["rarity"]
    caught_symbol = SYMBOL.get(caught_rarity, "⭐")
    await update.message.reply_text(
        "🎉 Character added to your collection!\n\n"
        f"Name: {spawn['name']}\n"
        f"Code: {spawn['code']}\n"
        f"Tier: {caught_rarity} {caught_symbol}\n"
        f"Worth: {spawn['worth']} 🪙\n\n"
        "💰 +50 coins"
    )


