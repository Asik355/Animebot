        )
        c.commit()
    except Exception:
        c.rollback(); c.close()
        await update.message.reply_text("❌ Could not complete the sale. Please try again.")
        return
    c.close()

    await update.message.reply_text(
        f"💸 Sold {name} [{code}] x{quantity}!\n💰 +{total_value} coins"
    )


