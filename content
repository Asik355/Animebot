# ---------- DATABASE ----------
def connect():
    # Keep SQLite operations from freezing the Telegram event loop for a long
    # time when another update is writing. WAL lets readers continue while a
    # writer is active, and the short timeout prevents a lock from stalling
    # the whole bot.
    c = sqlite3.connect(DB_NAME, timeout=2.0)
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA synchronous=NORMAL")
    c.execute("PRAGMA busy_timeout=2000")
    return c


def setup_database():
    c = connect()
    x = c.cursor()

    x.execute("""
        CREATE TABLE IF NOT EXISTS users_v2 (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            first_name TEXT,
            coins INTEGER DEFAULT 0,
            last_daily TEXT
        )
    """)

    # Safe migrations for existing databases.
    for table, column, definition in [
        ("users_v2", "last_name", "TEXT"),
    ]:
        try:
            x.execute(f"ALTER TABLE {table} ADD COLUMN {column} {definition}")
        except sqlite3.OperationalError:
            pass

    x.execute("""
        CREATE TABLE IF NOT EXISTS characters_v2 (
            code TEXT PRIMARY KEY,
            name TEXT UNIQUE COLLATE NOCASE,
            anime TEXT NOT NULL,
            rarity TEXT NOT NULL,
            worth INTEGER NOT NULL,
            photo_file_id TEXT
        )
    """)

    x.execute("""
        CREATE TABLE IF NOT EXISTS character_recruit_names_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            character_code TEXT NOT NULL,
            recruit_name TEXT NOT NULL COLLATE NOCASE,
            UNIQUE(character_code, recruit_name)
        )
    """)

    x.execute("""
        CREATE TABLE IF NOT EXISTS collections_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            character_code TEXT NOT NULL,
            caught_at TEXT
        )
    """)

    x.execute("""
        CREATE TABLE IF NOT EXISTS favorites_v2 (
            user_id INTEGER PRIMARY KEY,
            character_code TEXT NOT NULL,
            set_at TEXT NOT NULL
        )
    """)

    # New support/report tables. Existing database data is preserved.
    x.execute("""
        CREATE TABLE IF NOT EXISTS issues_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            username TEXT,
            first_name TEXT,
            issue_text TEXT NOT NULL,
            photo_file_id TEXT,
            created_at TEXT NOT NULL,
            status TEXT DEFAULT 'pending'
        )
    """)

    x.execute("""
        CREATE TABLE IF NOT EXISTS ideas_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            username TEXT,
            first_name TEXT,
            idea_text TEXT NOT NULL,
            photo_file_id TEXT,
            created_at TEXT NOT NULL,
            status TEXT DEFAULT 'pending'
        )
    """)

    x.execute("""
        CREATE TABLE IF NOT EXISTS appeals_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            username TEXT,
            first_name TEXT,
            appeal_text TEXT NOT NULL,
            photo_file_id TEXT,
            created_at TEXT NOT NULL,
            status TEXT DEFAULT 'pending'
        )
    """)

    # Auction system. A listed character is moved out of the seller collection
    # into escrow until the auction expires or is ended.
    x.execute("""
        CREATE TABLE IF NOT EXISTS auctions_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            seller_id INTEGER NOT NULL,
            character_code TEXT NOT NULL,
            start_bid INTEGER NOT NULL,
            current_bid INTEGER NOT NULL,
            highest_bidder_id INTEGER,
            ends_at TEXT NOT NULL,
            active INTEGER DEFAULT 1,
            created_at TEXT NOT NULL
        )
    """)

    x.execute("""
        CREATE TABLE IF NOT EXISTS auction_bids_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            auction_id INTEGER NOT NULL,
            bidder_id INTEGER NOT NULL,
            amount INTEGER NOT NULL,
            created_at TEXT NOT NULL
        )
    """)

    # Global rarity-spawn counters.
    x.execute("""
        CREATE TABLE IF NOT EXISTS staff_roles_v2 (
            user_id INTEGER PRIMARY KEY,
            role TEXT NOT NULL,
            added_at TEXT NOT NULL
        )
    """)

    # Load persisted executives first, then merge config-based IDs.
    x.execute("SELECT user_id FROM staff_roles_v2 WHERE role='executive'")
    for (stored_id,) in x.fetchall():
        if stored_id not in EXECUTIVE_IDS:
            EXECUTIVE_IDS.append(stored_id)

    x.execute("SELECT user_id FROM staff_roles_v2 WHERE role='scout'")
    for (stored_id,) in x.fetchall():
        if stored_id not in EXECUTIVE_IDS and stored_id not in SCOUT_IDS:
            SCOUT_IDS.append(stored_id)

    # Repair any legacy conflict deterministically: Owner/Executive always
    # outrank Scout, so a user cannot receive two staff roles accidentally.
    if EXECUTIVE_IDS and SCOUT_IDS:
        conflicting = set(EXECUTIVE_IDS) & set(SCOUT_IDS)
        for conflicting_id in conflicting:
            x.execute("DELETE FROM staff_roles_v2 WHERE user_id=? AND role='scout'", (conflicting_id,))
        SCOUT_IDS[:] = [uid for uid in SCOUT_IDS if uid not in conflicting]


    # Keep config-based executives synchronized without touching user/collection data.
    for executive_id in EXECUTIVE_IDS:
        x.execute(
            "INSERT INTO staff_roles_v2(user_id, role, added_at) VALUES(?,?,?) "
            "ON CONFLICT(user_id) DO UPDATE SET role=excluded.role",
            (executive_id, "executive", timestamp()),
        )

    x.execute("""
        CREATE TABLE IF NOT EXISTS spawn_limits_v2 (
            id INTEGER PRIMARY KEY CHECK (id = 1),
            day_key TEXT NOT NULL,
            legendary_count INTEGER DEFAULT 0,
            mythic_count INTEGER DEFAULT 0,
            celestial_next_at TEXT
        )
    """)

    # Seed characters without overwriting existing rows/photos.
    for code, (name, anime, rarity) in enumerate(CHARACTERS, 1001):
        x.execute("""
            INSERT OR IGNORE INTO characters_v2
            (code, name, anime, rarity, worth, photo_file_id)
            VALUES (?, ?, ?, ?, ?, NULL)
        """, (str(code), name, anime, rarity, WORTH[rarity]))

    # Apply popularity-based rarity changes to existing seeded characters too.
    # Their worth follows the new rarity automatically.
    for name, rarity in POPULAR_RARITY_OVERRIDES.items():
        x.execute(
            "UPDATE characters_v2 SET rarity=?, worth=? WHERE name=? COLLATE NOCASE",
            (rarity, WORTH[rarity], name),
        )

    today_key = datetime.now().strftime("%Y-%m-%d")
    x.execute("""
        INSERT OR IGNORE INTO spawn_limits_v2
        (id, day_key, legendary_count, mythic_count, celestial_next_at)
        VALUES (1, ?, 0, 0, NULL)
    """, (today_key,))

    # Event system: one active event at a time.
    x.execute("""
        CREATE TABLE IF NOT EXISTS events_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            description TEXT DEFAULT '',
            reward_type TEXT NOT NULL,
            reward_value TEXT NOT NULL,
            end_at TEXT NOT NULL,
            active INTEGER DEFAULT 1,
            created_at TEXT NOT NULL
        )
    """)

    try:
        x.execute("ALTER TABLE events_v2 ADD COLUMN trigger_text TEXT DEFAULT ''")
    except sqlite3.OperationalError:
        pass

    x.execute("""
        CREATE TABLE IF NOT EXISTS event_claims_v2 (
            event_id INTEGER NOT NULL,
            user_id INTEGER NOT NULL,
            claimed_at TEXT NOT NULL,
            PRIMARY KEY (event_id, user_id)
        )
    """)

    # Redeem codes can be used once per user.
    x.execute("""
        CREATE TABLE IF NOT EXISTS redeem_codes_v2 (
            code TEXT PRIMARY KEY COLLATE NOCASE,
            reward_type TEXT NOT NULL,
            reward_value TEXT NOT NULL,
            created_at TEXT NOT NULL,
            active INTEGER DEFAULT 1
        )
    """)

    x.execute("""
        CREATE TABLE IF NOT EXISTS redeem_claims_v2 (
            code TEXT NOT NULL COLLATE NOCASE,
            user_id INTEGER NOT NULL,
            claimed_at TEXT NOT NULL,
            PRIMARY KEY (code, user_id)
        )
    """)

    x.execute("""
        CREATE TABLE IF NOT EXISTS spawn_history_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            chat_id INTEGER NOT NULL,
            character_code TEXT NOT NULL,
            rarity TEXT NOT NULL,
            spawned_by TEXT NOT NULL DEFAULT 'auto',
            spawned_at TEXT NOT NULL,
            caught_by INTEGER,
            caught_at TEXT
        )
    """)

    x.execute("""
        CREATE TABLE IF NOT EXISTS activity_log_v2 (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            username TEXT,
            first_name TEXT,
            chat_id INTEGER NOT NULL,
            command TEXT NOT NULL,
            created_at TEXT NOT NULL
        )
    """)

    c.commit()
    c.close()


def save_user(u):
    c = connect()
    x = c.cursor()
    x.execute("""
        INSERT INTO users_v2(user_id, username, first_name, last_name)
        VALUES (?, ?, ?, ?)
        ON CONFLICT(user_id) DO UPDATE SET
        username=excluded.username,
        first_name=excluded.first_name,
        last_name=excluded.last_name
    """, (u.id, u.username or "", u.first_name or "", u.last_name or ""))
    c.commit()
    c.close()


def get_recruit_names(character_code):
    c = connect(); x = c.cursor()
    x.execute("SELECT recruit_name FROM character_recruit_names_v2 WHERE character_code=? ORDER BY id", (str(character_code),))
    rows = [r[0] for r in x.fetchall()]
    c.close()
    return rows


def set_recruit_names(character_code, names):
    cleaned = []
    seen = set()
    for name in names or []:
        value = str(name).strip()
        key = value.casefold()
        if value and key not in seen:
            seen.add(key); cleaned.append(value)
    c = connect(); x = c.cursor()
    try:
        x.execute("DELETE FROM character_recruit_names_v2 WHERE character_code=?", (str(character_code),))
        x.executemany(
            "INSERT INTO character_recruit_names_v2(character_code,recruit_name) VALUES(?,?)",
            [(str(character_code), name) for name in cleaned]
        )
        c.commit()
    finally:
        c.close()
    return cleaned


def find_character_by_recruit_name(value):
    value = str(value).strip()
    if not value:
        return None
    c = connect(); x = c.cursor()
    x.execute("""
        SELECT c.code,c.name,c.anime,c.rarity,c.worth,c.photo_file_id
        FROM character_recruit_names_v2 r
        JOIN characters_v2 c ON c.code=r.character_code
        WHERE r.recruit_name=? COLLATE NOCASE
        LIMIT 1
    """, (value,))
    row=x.fetchone(); c.close(); return row


def find_characters_by_recruit_name_partial(value):
    value = str(value).strip()
    if not value:
        return []
    c = connect(); x = c.cursor()
    x.execute("""
        SELECT DISTINCT c.code,c.name,c.anime,c.rarity,c.worth,c.photo_file_id
        FROM character_recruit_names_v2 r
        JOIN characters_v2 c ON c.code=r.character_code
        WHERE r.recruit_name LIKE ? COLLATE NOCASE
        ORDER BY CAST(c.code AS INTEGER)
    """, (f"%{value}%",))
    rows=x.fetchall(); c.close(); return rows


def get_character_recruit_names_map(character_code):
    return get_recruit_names(character_code)


def get_character(value):
    c = connect(); x = c.cursor()
    value = str(value).strip()
    if value.isdigit() and 1 <= int(value) <= 9999:
        code = value.zfill(4)
        x.execute("SELECT code,name,anime,rarity,worth,photo_file_id FROM characters_v2 WHERE code=? LIMIT 1", (code,))
    else:
        x.execute("""
            SELECT code,name,anime,rarity,worth,photo_file_id
            FROM characters_v2
            WHERE name=? COLLATE NOCASE
            LIMIT 1
        """, (value,))
    row = x.fetchone(); c.close()
    if row:
        return row
    return find_character_by_recruit_name(value)

def get_character_by_code(code):
    code = str(code).strip()
    if not (code.isdigit() and 1 <= int(code) <= 9999):
        return None
    code = code.zfill(4)
    c = connect()
    x = c.cursor()
    x.execute("""
        SELECT code,name,anime,rarity,worth,photo_file_id
        FROM characters_v2
        WHERE code=?
        LIMIT 1
    """, (code,))
    row = x.fetchone()
    c.close()
    return row


