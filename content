async def notify_admins(context, text, photo_file_id=None):
    """Deliver Issue/Idea/Appeal submissions to Owner AND every Executive.

    Executive IDs are read from SQLite on every submission, so persisted
    Executive staff are notified even after a bot restart. Config-based IDs
    are also included. One failed recipient never blocks the others.
    """
    owner_id = ADMIN_IDS[0] if ADMIN_IDS else None

    executive_ids = set()
    try:
        c = connect(); x = c.cursor()
        x.execute("SELECT user_id FROM staff_roles_v2 WHERE role='executive'")
        executive_ids.update(int(row[0]) for row in x.fetchall())
        c.close()
    except Exception as e:
        print("Executive notification lookup error:", e)

    executive_ids.update(int(uid) for uid in EXECUTIVE_IDS)

    recipients = []
    if owner_id is not None:
        recipients.append(owner_id)
    recipients.extend(uid for uid in sorted(executive_ids) if uid != owner_id)

    if not recipients:
        print("Staff notification skipped: no Owner/Executive recipient configured")
        return

    delivered = 0
    for staff_id in recipients:
        try:
            if photo_file_id:
                if len(text) <= 1024:
                    await asyncio.wait_for(
                        context.bot.send_photo(
                            chat_id=staff_id,
                            photo=photo_file_id,
                            caption=text,
                        ),
                        timeout=15,
                    )
                else:
                    await asyncio.wait_for(
                        context.bot.send_photo(
                            chat_id=staff_id,
                            photo=photo_file_id,
                            caption="📎 Attachment for the submission below.",
                        ),
                        timeout=15,
                    )
                    await asyncio.wait_for(
                        context.bot.send_message(chat_id=staff_id, text=text),
                        timeout=15,
                    )
            else:
                await asyncio.wait_for(
                    context.bot.send_message(chat_id=staff_id, text=text),
                    timeout=15,
                )
            delivered += 1
            print(f"Staff notification delivered to {staff_id}")
        except asyncio.TimeoutError:
            print(f"Staff notification timeout for {staff_id}")
        except Exception as e:
            print(f"Staff notification error for {staff_id}: {e}")

    print(f"Staff notification result: {delivered}/{len(recipients)} delivered")


